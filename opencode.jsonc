{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:GHPAT}",
          "X-MCP-Toolsets": "repos,issues,pull_requests,actions,governance",
          "X-MCP-Readonly": "true",
        },
      },
    },
  },
}
