{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sadi-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sadi-hub",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "b44cf14b6d054e33ab74d4d94754ec31",
    },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://sadi-hub.mdsksadi2.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://mxbdrzroepmfoatmxgvn.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_MHDqTm7II7N9yETFw7vQeQ_WFt1PvTV",
  },
}
